{% extends 'base.html.twig' %}

{% block title %}Mon espace — {{ parent() }}{% endblock %}

{% block body %}
    <h1>Espace restaurateur</h1>
    <p>Connecté en tant que <strong>{{ app.user.userIdentifier }}</strong>{% if app.user.restaurantName %} ({{ app.user.restaurantName }}){% endif %}</p>
    <p>Vous gérez ici vos <strong>tables</strong> et votre <strong>établissement</strong>. L’administrateur plateforme gère la liste des restaurants (création de fiches, etc.).</p>
    <ul>
        <li><a href="{{ path('app_restaurateur_tables_index') }}">Tables de salle</a></li>
        <li><a href="{{ path('app_restaurateur_establishment') }}">Mon établissement (suppression)</a></li>
        <li>Planning des réservations (à venir)</li>
    </ul>
    <p><a href="{{ path('app_home') }}">← Accueil public</a></p>
{% endblock %}
