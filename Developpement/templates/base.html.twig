<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}RestO — réservation{% endblock %}</title>
    {# Gabarit volontairement sans feuille de styles métier (phase 2). #}
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}{% endblock %}
</head>
<body>
<header>
    <p><strong>RestO</strong> — démo technique</p>
    <nav aria-label="Navigation principale">
        <a href="{{ path('app_home') }}">Accueil</a>
        <span> | </span>
        <a href="{{ path('app_reserver') }}">Réserver</a>
        <span> | </span>
        {% if app.user %}
            <a href="{{ path('app_admin_dashboard') }}">Admin</a>
            <span> | </span>
            <a href="{{ path('app_logout') }}">Déconnexion</a>
        {% else %}
            <a href="{{ path('app_login') }}">Connexion admin</a>
            <span> | </span>
            <a href="{{ path('app_register') }}">Inscription</a>
        {% endif %}
    </nav>
    <hr>
</header>
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <p data-flash="{{ label }}">{{ message }}</p>
    {% endfor %}
{% endfor %}
<main>
    {% block body %}{% endblock %}
</main>
</body>
</html>
