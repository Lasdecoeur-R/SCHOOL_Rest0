{% extends 'base.html.twig' %}

{% block title %}Inscription — {{ parent() }}{% endblock %}

{% block body %}
    <h1>Inscription restaurateur</h1>

    {{ form_start(registrationForm) }}
        {{ form_errors(registrationForm) }}
        {{ form_row(registrationForm.email) }}
        {{ form_row(registrationForm.plainPassword) }}
        {{ form_row(registrationForm.restaurantName) }}
        <p><button type="submit">Créer mon compte</button></p>
    {{ form_end(registrationForm) }}

    <p>Déjà inscrit ? <a href="{{ path('app_login') }}">Connexion</a></p>
    <p><a href="{{ path('app_home') }}">← Accueil</a></p>
{% endblock %}
