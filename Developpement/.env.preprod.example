# --- Modèle pour une préproduction (optionnel) ------------------------------
# Symfony charge ce fichier seulement si APP_ENV=preprod sur le serveur
# (à définir dans les variables d’environnement du PaaS ou avant php-fpm).
#
# Alternative très courante : APP_ENV=prod + DATABASE_URL pointant vers la base « préprod »
# (même code qu’en prod, données différentes via l’hébergeur).
#
# Copier vers .env.preprod sur le serveur (ne pas committer de secrets).
#
# APP_SECRET=
# DATABASE_URL="mysql://utilisateur:motdepasse@hôte-base-préprod:3306/base_preprod?serverVersion=8.0.32&charset=utf8mb4"
### ---------------------------------------------------------------------------
