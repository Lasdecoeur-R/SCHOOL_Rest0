# Copiez ce fichier vers .env puis adaptez (cp / copy .env.example .env).
#
# Rappel des fichiers par APP_ENV :
#   • dev    → .env + .env.dev (poste local)
#   • test   → .env + .env.test (PHPUnit uniquement — pas un serveur préprod)
#   • prod   → variables sur le serveur ; préprod souvent APP_ENV=prod + autre DATABASE_URL
# Fichiers locaux ignorés par Git : .env.local, .env.dev.local, .env.prod.local, etc.

###> symfony/framework-bundle ###
APP_ENV=dev
# Obligatoire pour sessions / CSRF : remplacez par une chaîne aléatoire (ex. openssl rand -hex 16).
APP_SECRET=__REMPLACER_PAR_UNE_VALEUR_ALEATOIRE_LONGUE__
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# MySQL doit tourner (sinon erreur SQLSTATE[HY000] [2002]). Créez la base (CREATE DATABASE app;).
# En dev, préférez surcharger dans .env.dev (APP_ENV=dev).
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###
